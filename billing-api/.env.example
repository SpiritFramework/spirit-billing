# XAMPP MySQL (default root has empty password)
DATABASE_URL="mysql://root@127.0.0.1:3306/spirit_billing"

JWT_SECRET="dev-billing-secret-change-me"
# Optional separate key for encrypted panel API keys (defaults to JWT_SECRET)
# SECRETS_ENCRYPTION_KEY="another-long-random-secret"
NODE_ENV="development"
PORT=3001
HOST="0.0.0.0"
BILLING_URL="http://localhost:5174"
CORS_ORIGINS="http://localhost:5174"

# Spirit-Panel Application API (create key in panel Admin → API keys)
PANEL_API_URL="http://localhost:3000"
PANEL_WEB_URL="http://localhost:5173"
PANEL_APPLICATION_API_KEY="sp_identifier.secret"
# Production only: allow private IPs for panel URL (default false in production)
# PANEL_ALLOW_PRIVATE_URLS="true"

# Optional in-process renewal / overdue runner (default off — admin can still run jobs manually)
# BILLING_LIFECYCLE_SCHEDULER="true"
# BILLING_LIFECYCLE_INTERVAL_MS="900000"

INVOICE_PREFIX="INV"
DEFAULT_CURRENCY="GBP"
COMPANY_NAME="Spirit Host"
PAYMENT_INSTRUCTIONS="Pay by bank transfer and include your invoice number as the reference.\nWe will activate your service once payment is confirmed."

# Seed admin (required to create first admin — npm run db:seed)
ADMIN_EMAIL="admin@spirithost.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_FIRST_NAME="Spirit"
ADMIN_LAST_NAME="Admin"

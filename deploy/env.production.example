# Spirit Billing — production environment
# Installed to: /opt/spirit-billing/.env
# Permissions: 640 root:spirit-billing (never world-readable, never in the web root)
# Quote any value that contains spaces.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Public HTTPS URL of this billing site (no trailing slash)
BILLING_URL=https://billing.example.com
CORS_ORIGINS=https://billing.example.com

# MySQL / MariaDB — use a dedicated DB user, not root
DATABASE_URL="mysql://spirit_billing:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/spirit_billing"

# Secrets: generate with: openssl rand -base64 48
# Must be ≥32 chars and must not contain "change-me"
JWT_SECRET=
SECRETS_ENCRYPTION_KEY=

# Spirit-Panel Application API (Admin → API keys)
# Prefer a private/internal panel URL; leave PANEL_ALLOW_PRIVATE_URLS unset unless required
PANEL_API_URL=https://panel.example.com
PANEL_WEB_URL=https://panel.example.com
PANEL_APPLICATION_API_KEY=
# PANEL_ALLOW_PRIVATE_URLS=true

# Renewals, trial wipe, and overdue. Install and update set this to true.
BILLING_LIFECYCLE_SCHEDULER=true
# BILLING_LIFECYCLE_INTERVAL_MS=900000

INVOICE_PREFIX=INV
DEFAULT_CURRENCY=GBP
COMPANY_NAME="Spirit Host"
PAYMENT_INSTRUCTIONS="Pay by bank transfer and include your invoice number as the reference. We will activate your service once payment is confirmed."

# First admin (only used by: npm run db:seed)
# Password: min 16 chars, letter + number
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Spirit
ADMIN_LAST_NAME=Admin
